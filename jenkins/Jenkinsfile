pipeline {
    agent {
        kubernetes {
            yamlFile 'jenkins/pod-kaniko.yaml'
            defaultContainer 'builder'
        }
    }
    environment {
        PLATFORM_NAME = "Internal Developer Platform"
        SERVICES_FILE = "ci/services.yaml"
        CHANGED_FILE = "changed-services.txt"
        BUILD_DATE = "${new Date().format("yyyy-MM-dd HH:mm:ss")}"
        REGISTRY = "ucjfrog.exlservice.com"
        REPOSITORY = "idp-sandbox"
        IMAGE_NAMESPACE = "online-boutique"
        NAMESPACE = "online-boutique"
        ARGOCD_APP_NAME = "online-boutique"
        INITIAL_DEPLOYMENT = "false"
        JFROG_REGISTRY_HOST = "ucjfrog.exlservice.com"
        JFROG_REGISTRY_IP = "10.0.3.100"
    }
    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '20'
        ))
        timeout(
                time: 30,
                unit: 'MINUTES'
        )
        skipDefaultCheckout(true)
    }
    stages {
        /**********************************************************************
         * Checkout
         *********************************************************************/
        stage('Checkout Source') {
            steps {
                container('builder') {
                    checkout scm
                    sh '''
                        git config --global --add safe.directory '*'
                        echo
                        echo "Repository Checked Out"
                        echo
                        git status
                        pwd
                        ls -larth
                    '''
                }
            }
        }
        /**********************************************************************
         * Build Information
         *********************************************************************/
        stage('Build Information') {
            steps {
                container('builder') {
                    script {
                        env.GIT_COMMIT_SHORT =
                                sh(
                                        script: "git rev-parse --short HEAD",
                                        returnStdout: true
                                ).trim()
                        env.GIT_BRANCH_NAME =
                                sh(
                                        script: "git rev-parse --abbrev-ref HEAD",
                                        returnStdout: true
                                ).trim()
                    }
                    sh '''
                    echo
                    echo "========================================="
                    echo "Platform"
                    echo "========================================="
                    echo "Build Number  : ${BUILD_NUMBER}"
                    echo "Branch        : ${GIT_BRANCH_NAME}"
                    echo "Commit        : ${GIT_COMMIT_SHORT}"
                    echo "Workspace     : ${WORKSPACE}"
                    echo "Node          : ${NODE_NAME}"
                    echo
                    '''
                }
            }
        }
        /**********************************************************************
         * Validate Metadata
         *********************************************************************/
        stage('Validate Metadata') {
            steps {
                container('builder') {
                    sh '''
                    test -f ci/services.yaml
                    test -f scripts/detect-services.sh
                    chmod +x scripts/detect-services.sh
                    echo
                    echo "Metadata validation successful."
                    '''
                }
            }
        }
        /**********************************************************************
         * Resolve Deployment Mode
         *********************************************************************/
        stage('Resolve Deployment Mode') {
            steps {
                container('builder') {
                    script {
                        def kubectlAvailable = sh(
                                script: "set +e; command -v kubectl >/dev/null 2>&1; status=\$?; echo \$status; exit 0",
                                returnStdout: true
                        ).trim()
                        if (kubectlAvailable != '0') {
                            env.INITIAL_DEPLOYMENT = 'true'
                            echo "Initial deployment required: kubectl is unavailable."
                            writeFile file: '.deployment-mode', text: 'true'
                        } else {
                            def namespaceExists = sh(
                                    script: "set +e; kubectl get namespace ${env.NAMESPACE} >/dev/null 2>&1; status=\$?; echo \$status; exit 0",
                                    returnStdout: true
                            ).trim()
                            if (namespaceExists != '0') {
                                env.INITIAL_DEPLOYMENT = 'true'
                                echo "Initial deployment required: namespace ${env.NAMESPACE} is missing."
                                writeFile file: '.deployment-mode', text: 'true'
                            } else {
                                def workloadCount = sh(
                                        script: """
                                            set +e
                                            count=\$(kubectl get deployment,statefulset,daemonset -n ${env.NAMESPACE} -o name --ignore-not-found 2>/dev/null | wc -l | tr -d ' ')
                                            echo "${count}"
                                            exit 0
                                        """,
                                        returnStdout: true
                                ).trim()
                                def workloadCountValue = workloadCount.isInteger() ? workloadCount.toInteger() : 0
                                env.INITIAL_DEPLOYMENT = workloadCountValue > 0 ? 'false' : 'true'
                                if (env.INITIAL_DEPLOYMENT == 'true') {
                                    echo "Initial deployment required for namespace ${env.NAMESPACE}: no app workloads detected."
                                } else {
                                    echo "Incremental deployment mode enabled."
                                }
                                writeFile file: '.deployment-mode', text: env.INITIAL_DEPLOYMENT
                            }
                        }
                    }
                }
            }
        }
        /**********************************************************************
         * Detect Changed Services
         *********************************************************************/
        stage('Detect Changed Services') {
            steps {
                container('builder') {
                    withEnv(["INITIAL_DEPLOYMENT=${env.INITIAL_DEPLOYMENT}"]) {
                        sh '''
                        chmod +x scripts/detect-services.sh
                        ./scripts/detect-services.sh
                        '''
                    }
                }
            }
        }
        /**********************************************************************
         * Validate Result
         *********************************************************************/
        stage('Validate Changed Services') {
            steps {
                container('builder') {
                    script {
                        if (!fileExists(env.CHANGED_FILE)) {
                            error("changed-services.txt was not generated.")
                        }
                        def services = readFile(env.CHANGED_FILE).trim()
                        if (!services) {
                            currentBuild.description =
                                    "No service changes detected."
                            echo "No deployable services changed."
                        } else {
                            echo ""
                            echo "Changed Services"
                            echo ""
                            echo services
                            currentBuild.description =
                                    services.replace("\n", ", ")
                        }
                    }
                }
            }
        }
        /**********************************************************************
         * Quality Analysis
         *********************************************************************/
        stage('Quality Analysis') {
            parallel {
              stage('SonarQube') {
                  steps {
                      container('builder') {
                          withSonarQubeEnv('sonarqube') {
                              withCredentials([
                                  string(
                                      credentialsId: 'sonarqube-token',
                                      variable: 'SONAR_TOKEN'
                                  )
                              ]) {
                                  sh '''
                                      chmod +x scripts/run-sonarqube.sh
                                      ./scripts/run-sonarqube.sh
                                  '''
                              }
                          }
                      }
                  }
              }
              stage('Secret Scan') {
                  steps {
                      container('builder') {
                          sh '''
                              chmod +x scripts/run-secret-scan.sh
                              ./scripts/run-secret-scan.sh
                          '''
                      }
                  }
              }
              stage('Dependency Scan') {
                  steps {
                      container('builder') {
                          sh '''
                              chmod +x scripts/run-dependency-scan.sh
                              ./scripts/run-dependency-scan.sh
                          '''
                      }
                  }
              }
          }
      }
      /**********************************************************************
       * Archive Scan reports
       *********************************************************************/    
      stage('Archive Scan Reports') {
          steps {
            archiveArtifacts(
                artifacts: 'reports/**/*',
                fingerprint: true,
                allowEmptyArchive: true
                )
            }
        }
      /**********************************************************************
       * Sonar Quality Gate
       *********************************************************************/  
      stage('Sonar Quality Gate') {
          steps {
              timeout(time: 15, unit: 'MINUTES') {
                  waitForQualityGate abortPipeline: true
              }
          }
       }

       /**********************************************************************
        * Build and Publish Container Images
        *********************************************************************/
        stage('Build and Publish Images') {
            when {
                expression {
                    def deploymentMode = fileExists('.deployment-mode') ? readFile('.deployment-mode').trim() : 'false'
                    return deploymentMode == 'true' || (fileExists(env.CHANGED_FILE) && readFile(env.CHANGED_FILE).trim())
                }
            }
           steps {
               container('builder') {
                   sh '''
                       chmod +x scripts/build-images.sh scripts/push-images.sh
                       ./scripts/build-images.sh
                       ./scripts/push-images.sh
                   '''
               }
           }
       }

       /**********************************************************************
        * Update GitOps Manifests
        *********************************************************************/
        stage('Update GitOps Manifests') {
            when {
                expression {
                    def deploymentMode = fileExists('.deployment-mode') ? readFile('.deployment-mode').trim() : 'false'
                    return deploymentMode == 'true' || (fileExists(env.CHANGED_FILE) && readFile(env.CHANGED_FILE).trim())
                }
            }
           steps {
               container('builder') {
                   sh '''
                       chmod +x scripts/update-helm.sh
                       ./scripts/update-helm.sh
                   '''
               }
           }
       }

       /**********************************************************************
        * Deploy to EKS
        *********************************************************************/
        stage('Deploy to EKS') {
            when {
                expression {
                    def deploymentMode = fileExists('.deployment-mode') ? readFile('.deployment-mode').trim() : 'false'
                    return deploymentMode == 'true' || (fileExists(env.CHANGED_FILE) && readFile(env.CHANGED_FILE).trim())
                }
            }
           steps {
               container('builder') {
                   sh '''
                       chmod +x scripts/deploy-eks.sh
                       ./scripts/deploy-eks.sh
                   '''
               }
           }
       }

       /**********************************************************************
        * Sync ArgoCD Application
        *********************************************************************/
        stage('Sync ArgoCD Application') {
            when {
                expression {
                    def deploymentMode = fileExists('.deployment-mode') ? readFile('.deployment-mode').trim() : 'false'
                    return deploymentMode == 'true' || (fileExists(env.CHANGED_FILE) && readFile(env.CHANGED_FILE).trim())
                }
            }
           steps {
               container('builder') {
                   withCredentials([string(credentialsId: 'argocd-admin-password', variable: 'ARGOCD_PASSWORD')]) {
                       sh '''
                           chmod +x scripts/sync-argocd.sh
                           ARGOCD_PASSWORD="${ARGOCD_PASSWORD}" ./scripts/sync-argocd.sh
                       '''
                   }
               }
           }
       }

       /**********************************************************************
        * Validate Deployment Rollout
        *********************************************************************/
        stage('Validate Deployment Rollout') {
            when {
                expression {
                    def deploymentMode = fileExists('.deployment-mode') ? readFile('.deployment-mode').trim() : 'false'
                    return deploymentMode == 'true' || (fileExists(env.CHANGED_FILE) && readFile(env.CHANGED_FILE).trim())
                }
            }
           steps {
               container('builder') {
                   sh '''
                       chmod +x scripts/validate-deployment.sh
                       ./scripts/validate-deployment.sh
                   '''
               }
           }
       }
    }
    post {
        always {
            archiveArtifacts(
                    artifacts: '''
                        changed-services.txt,
                        reports/**/*,
                      ''',
                    fingerprint: true,
                    allowEmptyArchive: true
            )
            archiveArtifacts(
                    artifacts: 'ci/services.yaml',
                    fingerprint: true
            )
            cleanWs()
            deleteDir()
        }
        success {
            echo ""
            echo "=========================================="
            echo "Phase 1 completed successfully."
            echo "=========================================="
            echo ""
        }
        failure {
            echo ""
            echo "=========================================="
            echo "Pipeline failed."
            echo "=========================================="
            echo ""
        }
    }
}
